<Window x:Class="Mochi.App.Ui.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Mochi" Width="700" Height="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border CornerRadius="14" Margin="0,0,20,0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Image x:Name="PreviewImage" Width="230" Height="230" VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Meet your new kitten!" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Opacity="0.75" TextWrapping="Wrap" Margin="0,4,0,16"
                       Text="A fluffy little golden tabby kitten is moving onto your desktop, fairy lights and all. It curls up for a nap when you're away, purrs when you stroke its head and might just pounce on your cursor." />

            <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox x:Name="NameBox" MaxLength="24" Margin="0,0,0,12" />

            <TextBlock Text="Personality" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox x:Name="PersonalityBox" SelectionChanged="OnPersonalityChanged" />
            <TextBlock x:Name="PersonalityHint" Opacity="0.72" FontSize="12" TextWrapping="Wrap" Margin="2,4,0,12" />

            <TextBlock Text="Coat" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox x:Name="CoatBox" SelectionChanged="OnCoatChanged" Margin="0,0,0,14">
                <ComboBoxItem>Golden</ComboBoxItem>
                <ComboBoxItem>Cream</ComboBoxItem>
                <ComboBoxItem>Ginger</ComboBoxItem>
                <ComboBoxItem>Silver</ComboBoxItem>
            </ComboBox>

            <CheckBox x:Name="StartupBox" Content="Start my kitten when I sign in to Windows" />
            <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="28,2,0,16"
                       Text="Optional. You can change this any time in Settings. Mochi runs offline and never records you." />

            <Button x:Name="GoButton" Content="Let's go!" IsDefault="True" HorizontalAlignment="Right" Padding="22,6" Click="OnGo" />
        </StackPanel>
    </Grid>
</Window>
