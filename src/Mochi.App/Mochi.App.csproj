<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Mochi</AssemblyName>
    <RootNamespace>Mochi.App</RootNamespace>
    <ApplicationIcon>Assets\Mochi.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.1.0</Version>
    <Product>Mochi</Product>
    <Title>Mochi – desktop kitten</Title>
    <Description>A fluffy golden tabby kitten that lives on your desktop.</Description>
    <Copyright>Copyright © 2026</Copyright>
    <!-- WPF Fluent theme (ThemeMode) is marked experimental in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- An always-running background companion: favour a small footprint over GC throughput. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mochi.Core\Mochi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Mochi.ico" />
  </ItemGroup>

</Project>
