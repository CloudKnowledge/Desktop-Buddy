<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>30</SupportedOSPlatformVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Mochi</AssemblyName>
    <RootNamespace>Mochi.Droid</RootNamespace>
    <ApplicationId>com.cloudknowledge.mochi</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <!-- Settings and memory are saved with reflection-based System.Text.Json (shared with the other apps). -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mochi.Core\Mochi.Core.csproj" />
    <PackageReference Include="SkiaSharp.Views" Version="4.155.0" />
  </ItemGroup>

</Project>
